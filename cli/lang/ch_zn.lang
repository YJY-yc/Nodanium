[meta]
code = ch_zn
name = 简体中文

[welcome]
tagline = Nodanium
hint_help = 输入 'nodanium --help' 查看完整用法
hint_lang = 切换语言: --lang en
hint_download = 快速开始: nodanium download <链接>
version_line = 版本 {version}  |  {lang}

[cli]
app_title = Nodanium
gui_hint = 图形界面：不带参数运行即打开窗口；旧版参数：-c -s -r --download
usage = 用法
usage_line = nodanium download <链接> [选项]
commands = 命令
options = 选项
global_options = 全局选项
download_options = download 选项
examples = 示例
example_1 = nodanium download https://example.com/a.zip -j 16
example_2 = nodanium download https://example.com/a.zip -o ~/Downloads -f a.zip
example_3 = nodanium download https://example.com/a.zip --limit 5000 --run open
language_section = 语言切换
lang_help = 切换输出语言
exit_section = 中断
interrupt_help = 按 Ctrl+C 中止下载，进度会保存以便续传
cmd_help = 显示命令帮助
opt_help = 显示帮助信息并退出
opt_version = 显示版本并退出
opt_lang = 输出语言 (en / ch_zn)
opt_color = 颜色模式 (auto / always / never)
cmd_download = 多线程下载文件
cmd_tui = 交互式下载面板 (TUI)
resume_hint = 续传命令: nodanium resume <文件.ndf>
exitcodes = 退出码
exit_ok = 下载成功
exit_fail = 下载失败
exit_usage = 命令或参数错误
exit_noinfo = 无法获取文件信息（无 content-length）
exit_nospace = 磁盘空间不足
exit_abort = 用户中止 (Ctrl+C)，断点已保存

[opt]
url = 下载链接
output = 保存目录
filename = 输出文件名
jobs = 并发线程数 (默认取首选项, 最大128)
chunk_size = 分片大小 MB (默认取首选项)
cache = 内存缓冲 MB (默认取首选项)
limit = 限速 KB/s (0 表示不限速)
timeout = 探测文件信息超时秒数 (默认取首选项)
header = 自定义请求头 "Key: Value" (可重复)
header_json = 整包请求头 JSON
no_ssl_check = 关闭 SSL 校验
run = 完成后动作 (open / shutdown)
speed_unit = 速度单位 (默认取首选项)
json = 机器可读 JSON 输出
backend = 后端: auto(requests+curl 兜底) / requests / curl

[info]
header = 下载信息
url = 链接
filename = 文件名
save_path = 保存路径
total_size = 文件大小
chunks = 分片数
chunk_size = 分片大小
threads = 线程数
buffer = 缓冲
limit = 限速
supported = 支持多线程
unsupported = 服务器未返回 content-length，仅支持单线程
fetching = 正在获取文件信息...
resolved = 已重定向到 {url}
backend = 后端
backend_requests = requests
backend_curl = curl（绕过 TLS 指纹封锁）
curl_switching = requests 探测失败，正在切换 curl 兜底...
probe_slow = 探测较慢，curl 兜底仍在尝试中...

[progress]
line = {name}  {bar} {pct}%  {speed}  剩余 {eta}  [{done}/{total}]
chunk_line = 分片 {finished}/{total}  活跃 {active}
eta_short = 剩余
chunk_short = 片 {finished}/{total}  活 {active}
eta_calc = 计算中

[log]
starting = 开始下载: {filename}
saved_to = 保存到: {path}
resume_found = 发现断点数据，继续下载
retry = 分片 {idx} 重试 {n}/{max}: {err}
chunk_failed = 分片 {idx} 重试次数耗尽
interrupted = 下载中断，断点已保存: {path}
pause_saved = 断点已保存，可稍后恢复

[done]
success = 下载完成: {path}
success_short = 下载完成
time_cost = 耗时
avg_speed = 平均速度
failed = 下载失败: {reason}
failed_chunks = {n} 个分片重试耗尽
aborted = 用户已中止下载

[error]
url_required = 缺少下载链接
bad_url = 无效链接: {url}
output_required = 无法确定保存目录
path_create_failed = 无法创建保存目录: {path}
unknown_command = 未知命令: {cmd}
no_content_length = 服务器未返回 content-length，无法下载
fetch_failed = 获取文件信息失败: {reason}
curl_missing = 未在 PATH 中找到 curl，兜底后端不可用；安装 curl 可访问被 TLS 指纹封锁的链接
curl_missing_hint = 安装命令: sudo apt install curl
http_status = 服务器返回 HTTP {status}，链接可能已失效或需要 Cookie/请求头
curl_probe_failed = curl 探测失败
disk_space = 磁盘空间不足：需要 {need}，可用 {free}，请清理磁盘或更换保存目录

[tui]
home_title = Nodanium TUI 主菜单
menu_title = 可用功能:
menu_new = 新建下载
menu_refresh = 刷新下载列表
menu_settings = 设置
menu_quit = 退出
list_title = 下载列表 ({n} 条)
list_head = 文件名                     状态           大小        来源  时间
list_empty = 暂无下载记录
list_range = 显示第 {start}-{end} 条 / 共 {total} 条 (↑↓ 滚动)
home_hint = 1/Enter 新建   2/r 刷新   3/s 设置   4/q 退出   ↑↓ 滚动列表
title = 新建下载 (TUI)
field.url = 链接
field.output = 保存目录
field.filename = 文件名
field.jobs = 线程数
field.chunk_size = 分片 MB
field.limit = 限速 KB/s
blank = (空)
hint_entry = Enter 开始下载   Tab/上下键 切换   Ctrl+C 退出
hint_keys = 左右键移动光标   Backspace 删除
error_url = 请先填写下载链接
error_number = {field} 必须是数字
error_positive = {field} 必须为正数
starting = 正在启动下载...
result_ok = 下载完成
result_fail = 下载失败 (exit {code})
result_disk_space = 磁盘空间不足，无法开始下载
back_hint = 按任意键返回
not_tty = TUI 需要交互式终端 (TTY)
unsupported_windows = TUI 目前仅支持 Linux，Windows 请使用 CLI命令
setting_title = 设置 (Settings)
setting_download_dir = 默认下载目录
setting_dl_threads = 并发线程数
setting_dl_chunk_mb = 单分片大小 MB
setting_dl_cache_mb = 内存缓冲 MB
setting_dl_timeout = 连接超时 秒
setting_dl_read_stall = 读取停滞超时 秒
setting_dl_max_retry = 重试次数
setting_dl_speed_unit = 速度单位
setting_dl_disable_ssl = 忽略 SSL 证书校验
setting_on = 是
setting_off = 否
setting_hint = Enter 保存   Tab/上下 切换   空格/左右 切换开关与单位   Esc 返回
setting_keys = 修改后按 Enter 立即写入首选项配置
setting_saved = 已保存到首选项配置
setting_save_failed = 保存失败，请检查数据目录权限
error_dir = 默认下载目录不能为空
error_dir_create = 无法创建目录: {path}

cmd_title = 命令行
cmd_placeholder = 输入命令，Tab 补全，Enter 执行
cmd_hints = 候选
cmd_done = 命令结束 (exit {code})
hint_menu = ↑↓ 选择菜单   Enter 执行   Tab/→ 到列表   / 命令行   q 退出
hint_list = ↑↓ 选择记录   Enter 查看详情   r 继续下载   d 删除   Tab 切换   Esc 返回菜单
hint_cmd = 输入命令   Tab 自动补全   Enter 执行   ↑ 返回列表   Ctrl+C 清空
detail_title = 下载详情
