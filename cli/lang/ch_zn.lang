detail_timestamp = 时间
detail_resume_hint = 在列表按 r 可继续下载（需存在断点进度）
no_progress = 没有可用的断点进度，无法继续
confirm_delete = 确认删除记录 {name} ? (y/N)
confirm_yes_no = 按 y 确认，其他键取消

usage_line = 用法
